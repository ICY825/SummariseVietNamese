# Moi truong
.venv/
__pycache__/
*.pyc
*.egg-info/

# Du lieu: khong commit noi dung, chi giu cau truc thu muc
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Ket qua: giu cau truc, khong commit file du doan / bang chi so nang
results/predictions/*
!results/predictions/.gitkeep
# NGOAI LE: ban tom tat do mo hinh sinh ra thi KHONG tai tao duoc neu khong co GPU,
# va output cua cac version cu tren Kaggle thi CLI khong tai lai duoc. Tuan 7 (cham
# blind, phan tich loi) can dung chinh nhung file nay. Moi file ~0,4 MB.
# File du doan cua baseline van bi bo qua: chay lai `run_baselines.py` tren CPU la co.
!results/predictions/vit5-*.json
!results/predictions/bartpho-*.json
# LexRank ban nhung PhoBERT cung duoc giu, vi hai ly do: tuan 7 cham blind can ban
# tom tat CO DINH, va sinh lai khong chac ra dung nhu cu — no phu thuoc trong so
# PhoBERT tren Hub cung phien ban transformers, chu khong tat dinh nhu TF-IDF.
# Sinh lai cung ton 18 phut CPU cho 2.000 bai.
!results/predictions/*lexrank_emb*.json
# Tang 2 (PhoBERT chon cau) cung giu, cung ly do voi ViT5/BARTpho: mo hinh da
# huan luyen chi nam tren Kaggle, sinh lai can GPU, va tuan 7 cham blind can
# chinh nhung ban tom tat nay.
!results/predictions/phobert-sent-*.json
# Giai doan 2: cau BARTpho viet lai cau treo -- bang chung cho ket qua am, sinh lai mat
# ~9 phut CPU va can checkpoint 1,91 GB nam ngoai repo.
!results/predictions/viet-lai_*.json

# Khoa cham blind (nhan nao la he thong nao): KHONG commit, vi nguoi cham doc duoc repo
# thi quy trinh blind hong. Mat file cung khong sao: `human_eval.py prepare` tat dinh,
# chay lai tren may sach ra dung phieu va dung khoa (da kiem tung byte).
results/human_eval/khoa.json

# Cache va checkpoint
.cache/
checkpoints/
*.ckpt
wandb/

# He dieu hanh / IDE
.DS_Store
.ipynb_checkpoints/
